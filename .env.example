# Required: Claude API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Optional tuning
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
CHAT_MAX_TOKENS=8000
CHAT_FALLBACKS=true
RETRIEVAL_TOP_K=5

# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://publishpro.app,https://www.publishpro.app

# Optional: where "talk to the team" requests are delivered (helpdesk, Zapier/Make, Slack workflow...)
# Payload is JSON; if SUPPORT_WEBHOOK_SECRET is set the body is signed (HMAC-SHA256 hex in x-publishpro-signature).
SUPPORT_WEBHOOK_URL=
SUPPORT_WEBHOOK_SECRET=
SUPPORT_EMAIL=support@publishpro.app

# Abuse protection (per IP)
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200
# Set true when running behind a proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY=false

PORT=8787

# Preview only: scripted answers instead of model calls (no API key needed). Never in production.
DEMO_MODE=false
